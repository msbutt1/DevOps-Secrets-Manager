# Database Configuration
DATABASE_USER=secrets_user
DATABASE_PASSWORD=secrets_password
DATABASE_NAME=secrets_db

# Security keys: replace both placeholders before starting the stack.
# The API refuses to start while either value is missing, too short or still a placeholder.
# Generate each one with: openssl rand -hex 32
MASTER_KEK=change-me
JWT_SECRET=change-me

# Server Configuration
SERVER_PORT=8080

# Email Configuration (Optional - for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# Application URL
APP_URL=http://localhost:3000
