# Database Configuration
DATABASE_USER=secrets_user
DATABASE_PASSWORD=secrets_password
DATABASE_NAME=secrets_db

# Security keys: replace both placeholders before starting the stack.
# The API refuses to start while either value is missing, too short or still a placeholder.
# Generate each one with: openssl rand -hex 32
MASTER_KEK=change-me
JWT_SECRET=change-me

# Server Configuration
SERVER_PORT=8080

# Runtime environment. "development" enables local fallbacks such as logging emailed
# links when SMTP is not configured. Use "production" for any real deployment.
APP_ENV=development

# Base URL of the web app, used to build links in emails
APP_PUBLIC_URL=http://localhost:3000

# Seconds the web app shows a revealed secret before hiding it (5-600, default 30)
APP_REVEAL_AUTO_HIDE_SECONDS=30

# Web app origins allowed to call the API directly from another origin (comma-separated).
# Not needed when the web app reaches the API through its /api proxy.
APP_CORS_ALLOWED_ORIGINS=

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated CIDRs).
# Leave empty for loopback and private networks, which covers the bundled nginx container.
APP_TRUSTED_PROXIES=

# Email (optional in development: without SMTP_HOST the API logs verification links instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
